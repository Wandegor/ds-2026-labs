@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
}

<div class="text-center">
    <form method="post">
        <div class="col-2">Текст для оценки:</div>
        <div class="col-10">
            @* отсюда OnPost(string text) получит значение *@
            <textarea name="text" rows="5" cols="50"></textarea>
            
            <div style="margin: 10px 0;">
                <label>Регион:</label>
                <select name="Region" required>
                    <option value="RU">Russia</option>
                    <option value="EU">France/Germany</option>
                    <option value="ASIA">UAE/India</option>
                </select>
            </div>
            
            <input type="submit"/>
        </div>
    </form>
</div>